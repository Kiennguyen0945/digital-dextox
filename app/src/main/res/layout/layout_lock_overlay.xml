<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000"
    android:clickable="true"
    android:focusable="true">

    <ScrollView
        android:id="@+id/scrollViewOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="48dp"
            android:paddingBottom="32dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ĐIỆN THOẠI ĐANG BỊ KHÓA"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textAlignment="center"/>

            <TextView
                android:id="@+id/tvCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="00:00:00"
                android:textColor="#FF5252"
                android:textSize="48sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnUnlockEarly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="CÓ VIỆC GẤP? MỞ KHÓA SỚM"
                android:backgroundTint="#555555" />

            <!-- Khu vực nhập mã (ẩn mặc định) -->
            <LinearLayout
                android:id="@+id/layoutUnlockArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gõ chính xác chuỗi sau để mở khóa:"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvRandomHash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#333333"
                    android:padding="16dp"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textIsSelectable="false" />

                <com.example.digitaldextox.NoPasteEditText
                    android:id="@+id/etHashInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Nhập lại chuỗi trên..."
                    android:textColorHint="#888888"
                    android:textColor="#FFFFFF"
                    android:inputType="textVisiblePassword|textNoSuggestions"
                    android:background="#222222"
                    android:padding="16dp"
                    android:imeOptions="actionDone" />

                <Button
                    android:id="@+id/btnConfirmUnlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="XÁC NHẬN"
                    android:backgroundTint="#4CAF50" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
